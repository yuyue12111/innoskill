PORT=3000
LOG_LEVEL=info

# 与根目录 docker-compose.yml 一致
DATABASE_URL=postgresql://innoskill:innoskill@localhost:5432/innoskill
REDIS_URL=redis://localhost:6379

S3_BUCKET=innoskill
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# 链路追踪:npm start 通过 --import 加载 OTel 自动埋点,本地默认关闭
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=innoskill-server
