# 监听端口
PORT=8080
# 运行时数据目录(SQLite、源仓库 clone、tar.gz 缓存)
DATA_DIR=./runtime
# 对外地址(生成 index.json 里的 demo 绝对地址用)
PUBLIC_URL=http://localhost:8080

# 内容源:默认 clone 上游仓库;本地开发可直接指向已 clone 的目录,跳过 git
SOURCE_REPO_URL=https://github.com/Chloris-Blaxk/inno-agent-hub.git
SOURCE_REF=main
# SOURCE_LOCAL_DIR=../inno-agent-hub
SKILLS_PATH=skill-library
PRESETS_PATH=workspace-templates

# 定时同步间隔(分钟),0 = 只在启动时同步
SYNC_INTERVAL_MIN=10
# POST /internal/sync 的密钥(X-Sync-Secret);不设则该接口关闭
SYNC_SECRET=
# 设了以后 bundle 协议接口要求 Authorization: Bearer <token>(inno-agent 的 contentHub.token)
HUB_TOKEN=
